# Streamlit Community Cloud secrets — paste into the app's Settings → Secrets (never commit a real secrets.toml).
# Root-level keys are also exposed as environment variables, which is how st_cloud_ui.py reads BACKEND_URL.
BACKEND_URL = "https://your-service-xxxxx.a.run.app"   # Cloud Run URL of the FastAPI backend (no trailing slash)
LOGFIRE_TOKEN = ""                                      # optional — UI traces are skipped when empty
